NOTIFY_SEND_KEY=replace-with-a-random-secret-at-least-32-characters
NOTIFY_DEVICE_KEYS='{"my-phone":"replace-with-a-different-random-secret-at-least-32-characters"}'
NOTIFY_STATE_FILE=data/devices.json
GOOGLE_APPLICATION_CREDENTIALS=secrets/firebase-service-account.json
NOTIFY_PUBLIC_URL=https://notify.example.com
NOTIFY_PAIR_PASSWORD=replace-with-an-independent-random-password
# Optional locally; production override mounts this read-only secret file.
# NOTIFY_ALEXA_CODE_FILE=secrets/alexa-access-code.txt
